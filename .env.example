# Copie para .env (chmod 600). NUNCA versione o .env.
# Os valores sensíveis devem vir de um gerenciador de senhas; não cole tokens no chat.

# --- Hetzner Cloud ---
# Token de API com escopo de leitura/escrita apenas no projeto Hetzner dedicado.
HCLOUD_TOKEN=

# Região e tipo de servidor (ver docs/adr/0001-provedor-e-sku.md).
TF_VAR_location=nbg1
TF_VAR_server_type=cx43
# Alternativas tentadas, em ordem, se o tipo principal estiver indisponível.
CDW_SERVER_TYPE_FALLBACKS=cpx42,ccx23

# IP público autorizado a acessar a porta 22 (CIDR, ex.: 203.0.113.10/32).
# Deixe vazio para detectar automaticamente o IP atual no make up.
TF_VAR_admin_cidr=

# Chave pública SSH a autorizar na VM (somente o arquivo .pub).
CDW_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
# Chave privada correspondente (padrão: o mesmo caminho sem .pub).
# CDW_SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519

# --- Estado OpenTofu (criptografado; ver docs/adr/0002-iac-e-estado.md) ---
# Arquivo local, fora do Git, contendo a passphrase de criptografia do estado.
CDW_STATE_PASSPHRASE_FILE=~/.config/cdw/state-passphrase
# Pasta do estado, do plano salvo e do known_hosts da VM (fora do repositório).
CDW_STATE_DIR=~/.local/state/cdw

# --- Backup restic (make backup/restore; ver docs/adr/0003-persistencia-e-backup.md) ---
# Destino: Cloudflare R2 (recomendado; sem egress, 10 GB/mês grátis).
# RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# Arquivo local (fora do Git), uma senha por linha, mínimo 16 caracteres.
RESTIC_PASSWORD_FILE=~/.config/cdw/restic-password
# Token de API R2 (ou chave S3 do destino escolhido), acesso só ao bucket dedicado.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 usa "auto"; um destino S3 regional (ex.: Backblaze B2 via S3) usa a região real.
AWS_DEFAULT_REGION=auto
# Retenção do "restic forget --prune" rodado a cada make backup.
CDW_BACKUP_KEEP_DAILY=7
CDW_BACKUP_KEEP_WEEKLY=4
CDW_BACKUP_KEEP_MONTHLY=6
# make restore: snapshot a restaurar ("latest" ou um ID curto do restic).
# CDW_RESTORE_SNAPSHOT=latest

# --- Compose na VM (make deploy; ver docs/adr/0004-agentes-e-imagens.md) ---
# Perfis a subir, separados por vírgula: tools, db, cache ou full.
CDW_COMPOSE_PROFILES=tools
# Imagem de ferramentas publicada no GHCR (necessária se "tools" estiver nos
# perfis). Preenchida com o digest impresso pelo workflow build-images.yml.
# CDW_TOOLS_IMAGE=ghcr.io/<owner>/cloud-workstation-dev@sha256:<digest>
# Pasta na VM com os projetos, montada no contêiner de ferramentas.
CDW_PROJECTS_DIR=/home/dev/work
# Necessárias se "db" ou "full" estiverem nos perfis.
POSTGRES_USER=dev
POSTGRES_PASSWORD=
POSTGRES_DB=dev
