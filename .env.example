# Copie para .env (chmod 600). NUNCA versione o .env.
# Os valores sensíveis devem vir de um gerenciador de senhas; não cole tokens no chat.

# --- Hetzner Cloud ---
# Token de API com escopo de leitura/escrita apenas no projeto Hetzner dedicado.
HCLOUD_TOKEN=

# Região e tipo de servidor (ver docs/adr/0001-provedor-e-sku.md).
TF_VAR_location=nbg1
TF_VAR_server_type=cx43
# Alternativas tentadas, em ordem, se o tipo principal estiver indisponível.
CDW_SERVER_TYPE_FALLBACKS=cpx42,ccx23

# IP público autorizado a acessar a porta 22 (CIDR, ex.: 203.0.113.10/32).
# Deixe vazio para detectar automaticamente o IP atual no make up.
TF_VAR_admin_cidr=

# Chave pública SSH a autorizar na VM (somente o arquivo .pub).
CDW_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
# Chave privada correspondente (padrão: o mesmo caminho sem .pub).
# CDW_SSH_PRIVATE_KEY_FILE=~/.ssh/id_ed25519

# --- Estado OpenTofu (criptografado; ver docs/adr/0002-iac-e-estado.md) ---
# Arquivo local, fora do Git, contendo a passphrase de criptografia do estado.
CDW_STATE_PASSPHRASE_FILE=~/.config/cdw/state-passphrase
# Pasta do estado, do plano salvo e do known_hosts da VM (fora do repositório).
CDW_STATE_DIR=~/.local/state/cdw

# --- Backup restic (ver docs/adr/0003-persistencia-e-backup.md) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=~/.config/cdw/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
